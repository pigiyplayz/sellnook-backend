# Required
RESEND_API_KEY=your_resend_api_key_here

# Optional - defaults to https://sellnook-backend.onrender.com
BACKEND_URL=https://sellnook-backend.onrender.com
RENDER_EXTERNAL_URL=https://sellnook-backend.onrender.com

# Firebase (choose one method)
# Option A: Individual environment variables
FIREBASE_PROJECT_ID=sellnook-1
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Option B: Single JSON blob (base64 encoded or raw JSON)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Stripe (when ready)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
